# Calculate fixed-time period
get_fixed_period() {
    local current_time
    current_time=$(date '+%H:%M')

    # Convert times to minutes for comparison
    local current_mins day_mins night_mins
    current_mins=$((10#${current_time%%:*} * 60 + 10#${current_time##*:}))
    day_mins=$((10#${DAY_START%%:*} * 60 + 10#${DAY_START##*:}))
    night_mins=$((10#${NIGHT_START%%:*} * 60 + 10#${NIGHT_START##*:}))

    if [[ $current_mins -ge $day_mins ]] && [[ $current_mins -lt $night_mins ]]; then
        echo "day"
    else
        echo "night"
    fi
}

# Get current period (day/night)
get_period() {
    local period

    if [[ "$MODE" == "solar" ]]; then
        period=$(get_solar_period)
        if [[ "$period" == "error" ]]; then
            info "Solar mode failed, falling back to fixed time"
            period=$(get_fixed_period)
        fi
    else
        period=$(get_fixed_period)
    fi

    echo "$period"
}

# Main
main() {
    ensure_state_dir
    load_config

    debug "Mode: $MODE"
    debug "Location: $LATITUDE, $LONGITUDE ($TIMEZONE)"

    local period theme
    period=$(get_period)
    debug "Current period: $period"

    # Check for forced period (sticky manual override)
    local forced_period
    forced_period=$(get_forced_period)
    if [[ -n "$forced_period" ]]; then
        debug "Forced period active: $forced_period"
        if [[ "$forced_period" == "$period" ]]; then
            # Solar has caught up with the forced period, clear the override
            info "Solar period now matches forced period ($period), clearing override"
            clear_forced_period
        else
            # Still in override mode, don't switch
            debug "Override active: staying on $forced_period until solar catches up"
            exit 0
        fi
    fi

    if [[ "$period" == "day" ]]; then
        theme="$LIGHT_THEME"
    else
        theme="$DARK_THEME"
    fi

    local current_state
    current_state=$(get_current_state)
    debug "Current state: $current_state"
    debug "Target theme: $theme"

    if [[ "$current_state" == "$theme" ]]; then
        debug "Theme already applied, skipping"
        exit 0
    fi

    local tool
    tool=$(detect_apply_tool)
    if [[ -z "$tool" ]]; then
        error "No theme apply tool available"
        exit 1
    fi

    if apply_theme "$theme"; then
        save_state "$theme"
        info "Theme switched to: $theme (period: $period)"
    else
        error "Failed to switch theme"
        exit 1
    fi
}

# Handle arguments
case "${1:-}" in
    --force-day)
        ensure_state_dir
        load_config
        if apply_theme "$LIGHT_THEME"; then
            save_state "$LIGHT_THEME"
            save_forced_period "day"
            info "Forced to day theme (will persist until solar period becomes day)"
        fi
        ;;
    --force-night)
        ensure_state_dir
        load_config
        if apply_theme "$DARK_THEME"; then
            save_state "$DARK_THEME"
            save_forced_period "night"
            info "Forced to night theme (will persist until solar period becomes night)"
        fi
        ;;
    --status)
        ensure_state_dir
        load_config
        period=$(get_period)
        current=$(get_current_state)
        forced=$(get_forced_period)
        echo "Mode: $MODE"
        echo "Current period: $period"
        echo "Applied theme: ${current:-none}"
        if [[ -n "$forced" ]]; then
            echo "Manual override: $forced (until solar catches up)"
        fi
        ;;
    --help|-h)
        echo "Usage: oneqode-theme-switch [OPTION]"
        echo ""
        echo "Options:"
        echo "  --force-day    Force light theme"
        echo "  --force-night  Force dark theme"
        echo "  --status       Show current status"
        echo "  --help         Show this help"
        echo ""
        echo "Without options, auto-switches based on configuration."
        ;;
    "")
        main
        ;;
    *)
        echo "Unknown option: $1" >&2
        echo "Use --help for usage information" >&2
        exit 1
        ;;
esac
