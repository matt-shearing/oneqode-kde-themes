#!/usr/bin/env bash
# OneQode Theme Switcher
# Automatically switches between Light Glass and Night Ride themes
# based on solar time or fixed schedule.

set -euo pipefail

# Paths
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/oneqode/oneqode-theme-switcher.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/oneqode"
STATE_FILE="$STATE_DIR/theme-state"
FORCE_FILE="$STATE_DIR/force-period"
LOG_FILE="$STATE_DIR/theme-switch.log"

# Defaults (overridden by config)
MODE="solar"
LATITUDE="-33.8688"
LONGITUDE="151.2093"
TIMEZONE="Australia/Sydney"
DAY_START="07:30"
NIGHT_START="18:30"
SUNRISE_OFFSET=0
SUNSET_OFFSET=0
LIGHT_THEME="org.oneqode.lightglass"
DARK_THEME="org.oneqode.nightride"
DEBUG="false"

# Ensure state directory exists (called early)
mkdir -p "$STATE_DIR"

# Logging
log() {
    local level="$1"
    shift
    local msg="$*"
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $msg" >> "$LOG_FILE"
    if [[ "$DEBUG" == "true" ]] || [[ "$level" == "ERROR" ]]; then
        echo "[$level] $msg" >&2
    fi
}

debug() {
    if [[ "$DEBUG" == "true" ]]; then
        log "DEBUG" "$@"
    fi
}

info() {
    log "INFO" "$@"
}

error() {
    log "ERROR" "$@"
}

# Load configuration
load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
        debug "Loaded config from $CONFIG_FILE"
    else
        info "No config file found at $CONFIG_FILE, using defaults"
    fi
}

# Ensure state directory exists
ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

# Get current theme state
get_current_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo ""
    fi
}

# Save theme state
save_state() {
    local theme="$1"
    echo "$theme" > "$STATE_FILE"
    debug "Saved state: $theme"
}

# Get forced period (if any)
get_forced_period() {
    if [[ -f "$FORCE_FILE" ]]; then
        cat "$FORCE_FILE"
    else
        echo ""
    fi
}

# Save forced period (for sticky manual switches)
save_forced_period() {
    local period="$1"
    echo "$period" > "$FORCE_FILE"
    debug "Saved forced period: $period"
}

# Clear forced period (when solar catches up)
clear_forced_period() {
    rm -f "$FORCE_FILE"
    debug "Cleared forced period"
}

# Detect theme apply tool
detect_apply_tool() {
    if command -v plasma-apply-lookandfeel &>/dev/null; then
        echo "plasma-apply-lookandfeel"
    elif command -v lookandfeeltool &>/dev/null; then
        echo "lookandfeeltool"
    else
        echo ""
    fi
}

# Ensure Klassy decoration is set (safety net for first-time setup)
ensure_klassy_decoration() {
    # Check if Klassy is installed (check for plugin file)
    if [[ ! -f /usr/lib/qt6/plugins/org.kde.kdecoration3/org.kde.klassy.so ]] && \
       ! pacman -Qq klassy klassy-bin 2>/dev/null | grep -q klassy; then
        debug "Klassy not installed, skipping decoration setup"
        return 0
    fi

    # Check if Klassy is already configured — skip if nothing to do
    local current_lib
    current_lib=$(kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key library 2>/dev/null || echo "")
    if [[ "$current_lib" == "org.kde.klassy" ]]; then
        debug "Klassy decoration already configured"
        return 0
    fi

    # Klassy not set — write config and reconfigure KWin
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key library "org.kde.klassy"
    kwriteconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme "Klassy"
    qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null || true

    info "Klassy decoration configured and KWin reconfigured"
}

# Apply Klassy decoration config for the current theme variant
# Klassy requires presets to be imported via klassy-settings, not raw file copy
apply_klassy_config() {
    local theme="$1"
    local repo_dir="$HOME/dev/oneqode-kde-themes/assets/klassy"
    local installed_dir="/usr/share/oneqode-kde-themes/klassy"

    # Skip if Klassy is not installed
    if ! command -v klassy-settings &>/dev/null; then
        debug "klassy-settings not found, skipping config apply"
        return 0
    fi

    # Determine which preset to load
    local preset_name="" preset_file=""
    if [[ "$theme" == *"lightglass"* ]]; then
        preset_name="OneQode Light Glass"
        for dir in "$repo_dir" "$installed_dir"; do
            if [[ -f "$dir/OneQode_Light_Glass.klpw" ]]; then
                preset_file="$dir/OneQode_Light_Glass.klpw"
                break
            fi
        done
    else
        preset_name="OneQode Night Ride"
        for dir in "$repo_dir" "$installed_dir"; do
            if [[ -f "$dir/OneQode_Night_Ride.klpw" ]]; then
                preset_file="$dir/OneQode_Night_Ride.klpw"
                break
            fi
        done
    fi

    if [[ -z "$preset_file" ]]; then
        debug "No Klassy preset found for theme: $theme"
        return 0
    fi

    # Import the preset (updates windecopresetsrc)
    klassy-settings --force-import-invalid-version --import-preset "$preset_file" 2>/dev/null || {
        error "Failed to import Klassy preset: $preset_file"
        return 0
    }

    # Load the preset (applies to klassyrc + regenerates icons + signals KWin)
    klassy-settings --load-windeco-preset "$preset_name" 2>/dev/null || {
        error "Failed to load Klassy preset: $preset_name"
        return 0
    }

    info "Applied Klassy preset: $preset_name"
}

# Apply theme
apply_theme() {
    local theme="$1"
    local tool
    tool=$(detect_apply_tool)

    if [[ -z "$tool" ]]; then
        error "No theme apply tool found (plasma-apply-lookandfeel or lookandfeeltool)"
        return 1
    fi

    info "Applying theme: $theme using $tool"

    if [[ "$tool" == "plasma-apply-lookandfeel" ]]; then
        "$tool" -a "$theme" 2>&1 || {
            error "Failed to apply theme with plasma-apply-lookandfeel"
            return 1
        }
    else
        "$tool" -a "$theme" 2>&1 || {
            error "Failed to apply theme with lookandfeeltool"
            return 1
        }
    fi

    # Apply color scheme with accent color. plasma-apply-lookandfeel sets the
    # ColorScheme name but doesn't propagate accent-derived colors (selection,
    # hover, decoration focus). plasma-apply-colorscheme -a re-derives them all.
    # We also write AccentColor via kwriteconfig6 since plasma-apply-colorscheme
    # doesn't update that key itself.
    if [[ "$theme" == *"lightglass"* ]]; then
        plasma-apply-colorscheme OneQodeLightGlass -a "#00b4c8" 2>&1 || true
        kwriteconfig6 --file kdeglobals --group General --key AccentColor "0,180,200"
    else
        plasma-apply-colorscheme OneQodeNightRide -a "#ff0080" 2>&1 || true
        kwriteconfig6 --file kdeglobals --group General --key AccentColor "255,0,128"
    fi

    # Ensure Klassy decoration is properly set (plasma-apply-lookandfeel often misses this)
    ensure_klassy_decoration

    # Apply the matching Klassy decoration config (light/dark button colors, opacity, etc.)
    apply_klassy_config "$theme"

    # Update SDDM background (if we have permission)
    update_sddm_background "$theme"

    # Update terminal themes
    update_terminal_themes "$theme"

    # Update Mattermost (via its API — pushes the theme to the server)
    update_mattermost_theme "$theme"

    info "Successfully applied theme: $theme"
    return 0
}

# Update Mattermost theme via the API. The desktop app stores its session token
# (MMAUTHTOKEN) in plaintext in its Cookies DB; we read it at runtime so token
# rotation is handled automatically. All failures are non-fatal.
update_mattermost_theme() {
    local theme="$1"
    local variant="night"
    [[ "$theme" == *"lightglass"* ]] && variant="light"

    # Skip silently if the Mattermost desktop app isn't set up
    [[ -d "$HOME/.config/Mattermost" ]] || { debug "Mattermost not installed"; return 0; }

    # Locate theme assets (installed location, then dev repo, then system)
    local assets_dir=""
    for dir in "$HOME/.local/share/oneqode/mattermost" \
               "$HOME/dev/oneqode-kde-themes/assets/mattermost" \
               "/usr/share/oneqode-kde-themes/mattermost"; do
        [[ -f "$dir/oneqode-night-ride.json" ]] && { assets_dir="$dir"; break; }
    done
    [[ -z "$assets_dir" ]] && { debug "Mattermost assets not found"; return 0; }

    python3 - "$variant" "$assets_dir" <<'PYEOF' && debug "Mattermost theme set to $variant" || debug "Mattermost theme update skipped"
import sys, json, sqlite3, os, urllib.request, urllib.parse

variant, assets_dir = sys.argv[1], sys.argv[2]
mm = os.path.expanduser("~/.config/Mattermost")
cookies, config = os.path.join(mm, "Cookies"), os.path.join(mm, "config.json")

try:
    if not (os.path.exists(cookies) and os.path.exists(config)):
        sys.exit(1)
    servers = json.load(open(config)).get("servers", [])
    if not servers:
        sys.exit(1)
    base = servers[0]["url"].rstrip("/")
    host = urllib.parse.urlsplit(base).hostname or ""

    con = sqlite3.connect("file:%s?mode=ro&immutable=1" % cookies, uri=True)
    # Chromium keys cookies by host, and never drops rows for servers you've
    # since stopped using — so a box that once logged into a different Mattermost
    # keeps that stale MMAUTHTOKEN forever. Match the configured server's host and
    # take the most recently used row rather than whichever one comes first.
    row = con.execute(
        "SELECT value FROM cookies WHERE name='MMAUTHTOKEN'"
        " AND host_key IN (?, ?) ORDER BY last_access_utc DESC LIMIT 1",
        (host, "." + host)).fetchone()
    token = row[0] if row else ""
    if not token:
        sys.exit(1)  # logged out, or no cookie for the configured server

    fname = "oneqode-night-ride.json" if variant == "night" else "oneqode-light-glass.json"
    theme = json.load(open(os.path.join(assets_dir, fname)))
    theme.pop("mentionBj", None)  # drop stray typo key if present
    theme["type"] = "custom"
    value = json.dumps(theme)

    def api(method, path, data=None):
        req = urllib.request.Request(base + path, method=method, headers={
            "Authorization": "Bearer " + token, "Content-Type": "application/json"})
        body = json.dumps(data).encode() if data is not None else None
        with urllib.request.urlopen(req, body, timeout=10) as r:
            return json.loads(r.read() or "null")

    uid = api("GET", "/api/v4/users/me")["id"]
    prefs = api("GET", "/api/v4/users/me/preferences")
    names = sorted({p["name"] for p in prefs if p["category"] == "theme"})
    if "" not in names:
        names.append("")  # ensure the all-teams default is set too
    api("PUT", "/api/v4/users/me/preferences",
        [{"user_id": uid, "category": "theme", "name": n, "value": value} for n in names])
    sys.exit(0)
except Exception:
    sys.exit(1)
PYEOF
    return 0
}

# Update SDDM background for next login
update_sddm_background() {
    local theme="$1"
    local sddm_theme_dir="/usr/share/sddm/themes/breeze"
    local theme_conf="$sddm_theme_dir/theme.conf.user"

    # Skip if we can't write to SDDM theme dir
    if [[ ! -w "$sddm_theme_dir" ]]; then
        debug "No write access to SDDM theme dir, skipping"
        return 0
    fi

    local background
    if [[ "$theme" == *"lightglass"* ]]; then
        background="/usr/share/wallpapers/OneQode/OneQode-Light-Glass.jpg"
    else
        background="/usr/share/wallpapers/OneQode/OneQode-Night-Ride.jpg"
    fi

    # Only update if background exists
    if [[ -f "$background" ]]; then
        cat > "$theme_conf" <<EOF
[General]
background=$background
type=image
EOF
        debug "SDDM background updated to: $background"
    fi
}

# Update terminal themes (Konsole and Ghostty)
update_terminal_themes() {
    local theme="$1"
    local is_light=false

    if [[ "$theme" == *"lightglass"* ]]; then
        is_light=true
    fi

    # Update Konsole (also signals Yakuake)
    update_konsole_theme "$is_light"

    # Update Ghostty
    update_ghostty_theme "$is_light"

    # Update Herdr (agent workspace TUI)
    update_herdr_theme "$is_light"

    # Update fastfetch
    update_fastfetch_theme "$is_light"

    # Ensure Firefox has auto-switching CSS
    update_firefox_theme
}

# Update fastfetch config (OQ logo + accent colors) for the active theme
update_fastfetch_theme() {
    local is_light="$1"
    local ff_dir="$HOME/.config/fastfetch"

    local config_name
    if [[ "$is_light" == "true" ]]; then
        config_name="config-light-glass.jsonc"
    else
        config_name="config-night-ride.jsonc"
    fi

    # Check if our configs are installed
    if [[ ! -f "$ff_dir/$config_name" ]]; then
        debug "fastfetch config not found: $config_name"
        return 0
    fi

    # fastfetch reads config.jsonc — point it at the active variant.
    # New terminals pick it up automatically.
    ln -sf "$config_name" "$ff_dir/config.jsonc"
    debug "fastfetch config symlink updated to: $config_name"
}

# Update Konsole color scheme for default profile
update_konsole_theme() {
    local is_light="$1"
    local konsole_dir="$HOME/.local/share/konsole"
    local config_dir="$HOME/.config"

    local scheme_name
    if [[ "$is_light" == "true" ]]; then
        scheme_name="OneQodeLightGlass"
    else
        scheme_name="OneQodeNightRide"
    fi

    # Check if our color schemes are installed
    if [[ ! -f "$konsole_dir/${scheme_name}.colorscheme" ]]; then
        debug "Konsole color scheme not found: $scheme_name"
        return 0
    fi

    # Update default profile if it exists
    local default_profile
    default_profile=$(kreadconfig6 --file konsolerc --group "Desktop Entry" --key "DefaultProfile" 2>/dev/null || echo "")

    if [[ -n "$default_profile" && -f "$konsole_dir/$default_profile" ]]; then
        # Update the profile's color scheme
        kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Appearance" --key "ColorScheme" "$scheme_name"

        # Set cursor: block shape, blinking, with theme-matched color
        kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "CursorShape" "0"
        kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "BlinkingCursorEnabled" "true"
        kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "UseCustomCursorColor" "true"
        if [[ "$is_light" == "true" ]]; then
            kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "CustomCursorColor" "0,180,200"
            kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "CustomCursorTextColor" "250,252,255"
        else
            kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "CustomCursorColor" "255,0,128"
            kwriteconfig6 --file "$konsole_dir/$default_profile" --group "Cursor Options" --key "CustomCursorTextColor" "25,28,42"
        fi

        debug "Updated Konsole profile $default_profile to use $scheme_name"
    fi

    # Also update konsolerc for new windows
    kwriteconfig6 --file konsolerc --group "UiSettings" --key "ColorScheme" "$scheme_name" 2>/dev/null || true

    # Resolve profile name from the profile file (for DBus calls)
    local profile_name=""
    if [[ -n "$default_profile" && -f "$konsole_dir/$default_profile" ]]; then
        profile_name=$(grep -oP '(?<=^Name=).*' "$konsole_dir/$default_profile" 2>/dev/null || echo "")
    fi

    # Signal running Konsole/Yakuake instances to reload (via DBus)
    # Requires AllowRemoteOperations=true in konsolerc [KonsoleWindow]
    if command -v qdbus6 &>/dev/null && [[ -n "$profile_name" ]]; then
        for service in $(qdbus6 2>/dev/null | grep 'org\.kde\.konsole-' | tr -d ' '); do
            for session in $(qdbus6 "$service" 2>/dev/null | grep '/Sessions/'); do
                # qdbus6 reports DBus errors on stdout, not stderr, so both are
                # dropped — otherwise a denied call prints through the switcher.
                qdbus6 "$service" "$session" org.kde.konsole.Session.setProfile "$profile_name" >/dev/null 2>&1 || true
            done
        done

        # Signal Yakuake sessions (Yakuake embeds Konsole's KPart)
        if qdbus6 org.kde.yakuake /yakuake/sessions 2>/dev/null | grep -q 'activeSessionId'; then
            for session_path in $(qdbus6 org.kde.yakuake 2>/dev/null | grep '/Sessions/'); do
                qdbus6 org.kde.yakuake "$session_path" org.kde.konsole.Session.setProfile "$profile_name" >/dev/null 2>&1 || true
            done
            debug "Signalled Yakuake sessions to reload profile"
        fi
    fi

    debug "Konsole theme updated to: $scheme_name"
}

# Ghostty 1.1+ pairs light/dark themes and follows the desktop appearance.
# The old `config-file = themes/oneqode-current` include loaded AFTER `theme =`
# and pinned a single palette, so the gtk-single-instance daemon never swapped
# at sunrise. SIGUSR1 reload also crashed Ghostty on some systems.
GHOSTTY_THEME_PAIR="theme = light:oneqode-light-glass,dark:oneqode-night-ride"

ensure_ghostty_theme_pairing() {
    local ghostty_config="$HOME/.config/ghostty/config"
    mkdir -p "$(dirname "$ghostty_config")"

    if [[ ! -f "$ghostty_config" ]]; then
        printf '%s\n' \
            "# Ghostty config" \
            "# OneQode theme (follows system light/dark)" \
            "$GHOSTTY_THEME_PAIR" \
            > "$ghostty_config"
        return 0
    fi

    if grep -q 'oneqode-current' "$ghostty_config"; then
        sed -i \
            -e '/# OneQode theme/d' \
            -e '/oneqode-current/d' \
            "$ghostty_config"
    fi

    if grep -qE '^[[:space:]]*theme[[:space:]]*=[[:space:]]*(light:oneqode-light-glass,[[:space:]]*dark:oneqode-night-ride|dark:oneqode-night-ride,[[:space:]]*light:oneqode-light-glass)[[:space:]]*$' "$ghostty_config"; then
        return 0
    fi

    if grep -qE '^[[:space:]]*theme[[:space:]]*=.*oneqode' "$ghostty_config"; then
        sed -i -E 's|^[[:space:]]*theme[[:space:]]*=.*oneqode.*|'"$GHOSTTY_THEME_PAIR"'|' "$ghostty_config"
        return 0
    fi

    if grep -qE '^[[:space:]]*theme[[:space:]]*=' "$ghostty_config"; then
        return 0
    fi

    printf '\n# OneQode theme (follows system light/dark)\n%s\n' "$GHOSTTY_THEME_PAIR" >> "$ghostty_config"
}

reload_ghostty() {
    # Official GTK action. New windows inherit the already-loaded config in
    # gtk-single-instance mode, so a reload is required for a live swap.
    busctl --user call com.mitchellh.ghostty /com/mitchellh/ghostty \
        org.gtk.Actions Activate sava{sv} reload-config 0 0 >/dev/null 2>&1 \
        || gdbus call --session --dest com.mitchellh.ghostty \
            --object-path /com/mitchellh/ghostty \
            --method org.gtk.Actions.Activate reload-config [] {} >/dev/null 2>&1 \
        || true
}

# Update Ghostty theme
update_ghostty_theme() {
    local is_light="$1"
    local ghostty_themes="$HOME/.config/ghostty/themes"

    local theme_name
    if [[ "$is_light" == "true" ]]; then
        theme_name="oneqode-light-glass"
    else
        theme_name="oneqode-night-ride"
    fi

    # Check if our themes are installed
    if [[ ! -f "$ghostty_themes/$theme_name" ]]; then
        debug "Ghostty theme not found: $theme_name"
        return 0
    fi

    # Keep the symlink current for anyone still listing oneqode-current.
    ln -sf "$theme_name" "$ghostty_themes/oneqode-current"

    # Prefer Ghostty's native light/dark pairing so it follows KDE appearance
    # without another signal. Self-heals older installs that still include the
    # flipping symlink.
    ensure_ghostty_theme_pairing

    reload_ghostty
    debug "Ghostty theme pairing ensured; reloaded to: $theme_name"
}

# Update Herdr UI palette (agent workspace TUI).
# Herdr has no user-named themes — we write a [theme.custom] block and reload.
update_herdr_theme() {
    local is_light="$1"
    local fragment_name
    if [[ "$is_light" == "true" ]]; then
        fragment_name="oneqode-light-glass.toml"
    else
        fragment_name="oneqode-night-ride.toml"
    fi

    local fragment="" apply=""
    local dir
    for dir in \
        "$HOME/.config/herdr/themes" \
        "$HOME/.local/share/oneqode/herdr" \
        "$HOME/dev/oneqode-kde-themes/assets/herdr" \
        "/usr/share/oneqode-kde-themes/herdr"
    do
        [[ -z "$fragment" && -f "$dir/$fragment_name" ]] && fragment="$dir/$fragment_name"
        [[ -z "$apply" && -f "$dir/apply-theme.py" ]] && apply="$dir/apply-theme.py"
    done

    if [[ -z "$fragment" || -z "$apply" ]]; then
        debug "Herdr theme assets not found, skipping"
        return 0
    fi

    python3 "$apply" --config "$HOME/.config/herdr/config.toml" "$fragment" 2>/dev/null || {
        debug "Herdr theme apply failed"
        return 0
    }

    if command -v herdr &>/dev/null; then
        herdr server reload-config >/dev/null 2>&1 || true
    fi
    debug "Herdr theme updated to: $fragment_name"
}

# Update Firefox userChrome.css + userContent.css to the auto-switching versions
update_firefox_theme() {
    local firefox_dir="$HOME/.mozilla/firefox"
    local repo_dir="$HOME/dev/oneqode-kde-themes/assets/firefox"
    local installed_dir="/usr/share/oneqode-kde-themes/firefox"

    # Find the auto CSS source directory
    local source_dir=""
    for dir in "$repo_dir" "$installed_dir"; do
        if [[ -f "$dir/userChrome-auto.css" ]]; then
            source_dir="$dir"
            break
        fi
    done

    if [[ -z "$source_dir" ]]; then
        debug "Firefox auto CSS not found, skipping"
        return 0
    fi

    # Find Firefox profiles and ensure auto CSS is deployed
    for profile_dir in "$firefox_dir"/*.default-release "$firefox_dir"/*.default; do
        if [[ -d "$profile_dir/chrome" ]]; then
            # Deploy userChrome.css (browser UI)
            local chrome_target="$profile_dir/chrome/userChrome.css"
            if [[ ! -f "$chrome_target" ]] || grep -q 'OneQode.*Firefox' "$chrome_target" 2>/dev/null; then
                cp "$source_dir/userChrome-auto.css" "$chrome_target"
                debug "Firefox userChrome.css updated in $profile_dir"
            fi

            # Deploy userContent.css (internal pages)
            local content_target="$profile_dir/chrome/userContent.css"
            if [[ -f "$source_dir/userContent-auto.css" ]]; then
                if [[ ! -f "$content_target" ]] || grep -q 'OneQode.*Firefox' "$content_target" 2>/dev/null; then
                    cp "$source_dir/userContent-auto.css" "$content_target"
                    debug "Firefox userContent.css updated in $profile_dir"
                fi
            fi
        fi
    done
}

# Calculate solar times using Python/astral
get_solar_period() {
    local python_script
    python_script=$(cat <<'PYTHON'
import sys
from datetime import datetime, timedelta
try:
    from astral import LocationInfo
    from astral.sun import sun
except ImportError:
    print("ERROR:astral_not_installed")
    sys.exit(1)

lat = float(sys.argv[1])
lon = float(sys.argv[2])
tz = sys.argv[3]
sunrise_offset = int(sys.argv[4])
sunset_offset = int(sys.argv[5])

try:
    from zoneinfo import ZoneInfo
except ImportError:
    from backports.zoneinfo import ZoneInfo

try:
    tzinfo = ZoneInfo(tz)
except Exception as e:
    print(f"ERROR:invalid_timezone:{e}")
    sys.exit(1)

location = LocationInfo(latitude=lat, longitude=lon, timezone=tz)
now = datetime.now(tzinfo)

try:
    s = sun(location.observer, date=now.date(), tzinfo=tzinfo)
except Exception as e:
    print(f"ERROR:sun_calculation:{e}")
    sys.exit(1)

sunrise = s['sunrise'] + timedelta(minutes=sunrise_offset)
