# OneQode Light Glass - Ghostty Theme
# A light, glass-inspired theme with ice cyan accents
#
# palette 7/15 are readable inks, not near-white. TUIs (Claude Code, Herdr
# panes) treat "white" as a foreground; #eee8d5 / #ffffff vanish on #fafcff.
# minimum-contrast lifts leftover truecolor greys without flattening brand hues.

background = #fafcff
foreground = #232d37

# Transparency (0.0 = fully transparent, 1.0 = opaque)
background-opacity = 0.95

# Only lift near-invisible greys. 3+ remapped Herdr status dots
# (yellow/green/cyan) to black on Light Glass.
minimum-contrast = 1.5

# Help theme=auto apps (Claude Code) classify this as a light terminal.
env = COLORFGBG=0;15

cursor-color = #00b4c8
cursor-text = #fafcff

selection-background = #00b4c8
selection-foreground = #ffffff

# Normal colors
palette = 0=#232d37
palette = 1=#dc322f
palette = 2=#2aa198
palette = 3=#b58900
palette = 4=#268bd2
palette = 5=#d33682
palette = 6=#00b4c8
palette = 7=#5a6a7a

# Bright colors
palette = 8=#3c464f
palette = 9=#ff5555
palette = 10=#50c8b4
palette = 11=#dcb43c
palette = 12=#50aaff
palette = 13=#ff64b4
palette = 14=#3cd2e6
palette = 15=#232d37
