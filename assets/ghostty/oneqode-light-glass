# OneQode Light Glass - Ghostty Theme
# A light, glass-inspired theme with ice cyan accents

background = #fafcff
foreground = #232d37

# Transparency (0.0 = fully transparent, 1.0 = opaque)
background-opacity = 0.95

cursor-color = #00b4c8
cursor-text = #fafcff

selection-background = #00b4c8
selection-foreground = #ffffff

# Normal colors (for light theme, "white" colors need to be dark for visibility)
palette = 0=#232d37
palette = 1=#dc322f
palette = 2=#2aa198
palette = 3=#b58900
palette = 4=#268bd2
palette = 5=#d33682
palette = 6=#00b4c8
palette = 7=#5a6a7a

# Bright colors
palette = 8=#4a5a6a
palette = 9=#c41a1a
palette = 10=#1a8a7a
palette = 11=#9a7000
