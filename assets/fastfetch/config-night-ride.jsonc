// OneQode Night Ride fastfetch config — OQ symbol logo, theme accent
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/oneqode.txt",
    "color": {
      "1": "38;2;255;0;128"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;255;0;128",
        "at": "white",
        "host": "38;2;255;0;128"
      }
    },
    {
      "type": "separator",
      "string": "\u2500"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "host",
      "key": "  Host",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "packages",
      "key": "  Packages",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "display",
      "key": "  Display",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "de",
      "key": "  DE",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "wmtheme",
      "key": "  WM Theme",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "theme",
      "key": "  Theme",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "icons",
      "key": "  Icons",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "font",
      "key": "  Font",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "cursor",
      "key": "  Cursor",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "terminalfont",
      "key": "  Term Font",
      "keyColor": "38;2;255;0;128"
    },
    "break",
    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "gpu",
      "key": "  GPU",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "memory",
      "key": "  Memory",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "swap",
      "key": "  Swap",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "disk",
      "key": "  Disk",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "localip",
      "key": "  Local IP",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "battery",
      "key": "  Battery",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "poweradapter",
      "key": "  Power",
      "keyColor": "38;2;255;0;128"
    },
    {
      "type": "locale",
      "key": "  Locale",
      "keyColor": "38;2;255;0;128"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
